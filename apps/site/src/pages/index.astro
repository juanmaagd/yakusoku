---
import TutorialVideo from "../components/ui/TutorialVideo";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import OwnerFlow from "../components/OwnerFlow.astro";
import BuiltForAgents from "../components/BuiltForAgents.astro";
import WhyRulesMiss from "../components/WhyRulesMiss.astro";
import HowItWorks from "../components/HowItWorks.astro";
import HumanApproval from "../components/HumanApproval.astro";
import Proof from "../components/Proof.astro";
import Developers from "../components/Developers.astro";
import SetupAgent from "../components/SetupAgent.astro";
import CloseCta from "../components/CloseCta.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Nav />
  <main class="overflow-x-clip">
    <div class="frame">
      <Hero />
      <OwnerFlow />
      <TutorialVideo topic="overview" client:load />
      <BuiltForAgents />
      <WhyRulesMiss />
      <HumanApproval />
      <Proof />
      <SetupAgent />
      <HowItWorks />
      <Developers />
      <CloseCta />
    </div>
  </main>
  <Footer />
</Layout>
