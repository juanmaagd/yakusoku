---
import TutorialVideo from "../components/ui/TutorialVideo";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import OwnerFlow from "../components/OwnerFlow.astro";
import Security from "../components/Security.astro";
import Pipeline from "../components/Pipeline.astro";
import Proof from "../components/Proof.astro";
import Developers from "../components/Developers.astro";
import SetupAgent from "../components/SetupAgent.astro";
import CloseCta from "../components/CloseCta.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Nav />
  <main class="overflow-x-clip">
    <div class="frame">
      <Hero />
      <OwnerFlow />
      <TutorialVideo topic="overview" client:load />
      <Security />
      <Proof />
      <SetupAgent />
      <Pipeline />
      <Developers />
      <CloseCta />
    </div>
  </main>
  <Footer />
</Layout>
