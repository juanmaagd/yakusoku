---
import Layout from "../layouts/Layout.astro";
import SetupFlow from "../components/setup/SetupFlow";
import { SITE } from "../config";
---

<Layout title={`Set up your account — ${SITE.name}`} description={`Link a wallet to your ${SITE.name} account so your agent can pay within your promises.`}>
  <header class="sticky top-0 z-40 border-b border-hairline bg-canvas">
    <div class="mx-auto flex h-16 max-w-[1200px] items-center px-6 md:px-8">
      <a href="/" class="flex shrink-0 items-center" aria-label={`${SITE.name} home`}>
        <img src="/brand/logo.svg" alt={SITE.name} width="188" height="24" class="h-6 w-auto" />
      </a>
    </div>
  </header>
  <main class="frame min-h-[calc(100vh-64px)] px-6 pb-20 pt-10 md:px-10 md:pt-12">
    <SetupFlow client:load />
  </main>
</Layout>
