---
import { fileURLToPath } from "node:url";
import Layout from "../layouts/Layout.astro";
import AppRoot from "../components/AppRoot";
import { SITE } from "../config";
const entryPath = import.meta.env.DEV ? fileURLToPath(new URL("../../../mcp/index.ts", import.meta.url)) : undefined;
---

<Layout title={`Promises — ${SITE.name}`}>
  <AppRoot client:load initialView="promises" entryPath={entryPath} />
</Layout>
