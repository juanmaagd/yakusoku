---
import { EVIDENCE, basescanTx } from "../config";

const STATS = [
  {
    headline: "19/19",
    body: "end-to-end scenarios pass — legit purchase, the key attack case, provenance traps, budget and expiry edges.",
  },
  {
    headline: "0.02",
    body: "Jev's matches_intent score for the key case: refused. The legitimate rehearsal purchase pays.",
  },
  {
    headline: "0",
    body: "unexplained on-chain payments: the independent verifier found none leaving the firewall wallet without a firewall decision.",
  },
] as const;

const TRANSACTIONS = [
  {
    label: "First firewall-signed payment",
    hash: EVIDENCE.firstFirewallSignedPayment,
  },
  {
    label: "Human-signed intent → purchase, with Jev live",
    hash: EVIDENCE.humanSignedIntentPurchase,
  },
  {
    label: "World ID approval → signed payment",
    hash: EVIDENCE.worldIdApprovedPayment,
  },
] as const;

function truncate(hash: string): string {
  return `${hash.slice(0, 10)}…${hash.slice(-8)}`;
}
---

<section id="proof" class="px-6 md:px-10">
  <div class="mx-auto max-w-[1200px]">
    <div class="mx-auto max-w-[60ch] text-center">
      <h2 class="text-heading-lg font-semibold text-ink">Proof, not claims</h2>
      <p class="mt-4 text-body text-graphite">Testnet only — every number below is reproducible from the repo.</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-3">
      {
        STATS.map((stat) => (
          <div class="rounded-card border border-black/[0.08] bg-surface p-6">
            <p class="text-display-sm font-semibold text-primary">{stat.headline}</p>
            <p class="mt-3 text-body-sm text-slate">{stat.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-5 rounded-card border border-black/[0.08] bg-surface p-6">
      <h3 class="text-body-sm font-medium text-stone">Real transactions, {"Base Sepolia"}</h3>
      <ul class="mt-4 divide-y divide-black/[0.08]">
        {
          TRANSACTIONS.map((tx) => (
            <li class="flex flex-col gap-1 py-3 first:pt-0 last:pb-0 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
              <span class="text-body-sm font-medium text-ink">{tx.label}</span>
              <a
                href={basescanTx(tx.hash)}
                target="_blank"
                rel="noreferrer"
                class="font-mono text-body-sm text-primary underline decoration-1 underline-offset-4 hover:opacity-80"
              >
                {truncate(tx.hash)} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
