---
import { EVIDENCE, basescanTx } from "../config";
import Arrow from "./Arrow.astro";

const STATS = [
  {
    label: "End-to-end scenarios",
    headline: "19/19",
    body: "pass — legit purchase, the key attack case, provenance traps, budget and expiry edges.",
  },
  {
    label: "Jev matches_intent, key case",
    headline: "0.02",
    body: "refused. The legitimate rehearsal purchase pays.",
  },
  {
    label: "Unexplained on-chain payments",
    headline: "0",
    body: "the independent verifier found none leaving the firewall wallet without a firewall decision.",
  },
] as const;

const TRANSACTIONS = [
  { label: "First firewall-signed payment", hash: EVIDENCE.firstFirewallSignedPayment },
  { label: "Human-signed intent → purchase, with Jev live", hash: EVIDENCE.humanSignedIntentPurchase },
  { label: "World ID approval → signed payment", hash: EVIDENCE.worldIdApprovedPayment },
] as const;

function truncate(hash: string): string {
  return `${hash.slice(0, 10)}…${hash.slice(-8)}`;
}
---

<section id="proof" class="band" aria-labelledby="proof-heading">
  <div class="grid grid-cols-1 items-end gap-10 md:grid-cols-[1fr_auto]">
    <div>
      <h2 id="proof-heading" class="headline text-[36px] leading-[1.06] tracking-[-0.02em] text-ink md:text-heading-lg">
        Proof, <strong>not claims.</strong>
      </h2>
      <p class="mt-6 max-w-[52ch] text-body-lg text-graphite">
        Testnet only — every number below is reproducible from the repo.
      </p>
    </div>
    <img
      src="/art/receipt.webp"
      alt=""
      width="1024"
      height="1024"
      loading="lazy"
      decoding="async"
      class="pointer-events-none mx-auto w-[200px] select-none md:-mb-4 md:w-[250px]"
    />
  </div>

  <dl class="stats mt-12 grid grid-cols-1 border-y border-hairline sm:grid-cols-3" data-inview>
    {
      STATS.map((stat, i) => (
        <div
          class="border-hairline py-7 sm:px-6 sm:first:pl-0 sm:last:pr-0 max-sm:[&:not(:first-child)]:border-t sm:[&:not(:first-child)]:border-l"
        >
          <dt class="label text-graphite">{stat.label}</dt>
          <dd class="mt-3">
            <span class="stat-num block text-[48px] leading-none font-medium tracking-[-0.03em] text-ink tabular-nums" style={`--i: ${i}`}>{stat.headline}</span>
            <span class="mt-3 block max-w-[34ch] text-body-sm text-graphite">{stat.body}</span>
          </dd>
        </div>
      ))
    }
  </dl>

  <div class="mt-10">
    <p class="label text-graphite">Real transactions · Base Sepolia</p>
    <ul class="mt-4 divide-y divide-hairline border-y border-hairline">
      {
        TRANSACTIONS.map((tx) => (
          <li class="flex flex-col gap-1 py-3.5 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
            <span class="text-body-sm text-ink">{tx.label}</span>
            <a
              href={basescanTx(tx.hash)}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-2 font-mono text-caption text-ink underline decoration-hairline-strong decoration-1 underline-offset-4 transition-colors duration-200 ease-out hover:decoration-ink"
            >
              {truncate(tx.hash)}
              <Arrow dir="up-right" />
              <span class="sr-only">View on Basescan</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* The figures come into focus once, left to right. */
  :global(.js) .stats .stat-num {
    transition:
      opacity 520ms var(--ease-out-soft),
      transform 620ms var(--ease-out-soft),
      filter 620ms var(--ease-out-soft);
    transition-delay: calc(var(--i) * 150ms);
  }
  :global(.js) .stats:not(.is-in) .stat-num {
    opacity: 0;
    transform: translateY(10px);
    filter: blur(6px);
  }
</style>
