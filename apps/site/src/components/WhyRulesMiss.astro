---
const DETERMINISTIC_CHECKS = [
  "Within budget",
  "Sent to a known, clean address",
  "Correct network and asset",
  "Address isn't sanctioned",
];
---

<section class="band" aria-labelledby="why-heading">
  <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div data-reveal>
      <h2 id="why-heading" class="headline text-[36px] leading-[1.06] tracking-[-0.02em] text-ink md:text-heading-lg">
        Why deterministic rules <strong>miss it.</strong>
      </h2>
      <p class="mt-6 max-w-[52ch] text-body-lg text-graphite">
        The key attack case passes every deterministic rule a firewall usually runs. It's within budget, sent to the
        store's own clean wallet, on the right network, and the address isn't sanctioned. The only question that
        catches it is the one deterministic rules can't ask: does this match what the user actually requested?
      </p>
    </div>

    <div class="relative pt-24 sm:pt-28" data-reveal style="--reveal-i: 1">
      <img
        src="/art/bait.webp"
        alt=""
        width="1024"
        height="1024"
        loading="lazy"
        decoding="async"
        class="pointer-events-none absolute -top-6 right-0 z-0 w-[190px] select-none sm:w-[240px] lg:-top-10 lg:-right-6 lg:w-[270px]"
      />
      <ul class="relative z-10 divide-y divide-hairline overflow-hidden rounded-card border border-hairline bg-surface">
        {
          DETERMINISTIC_CHECKS.map((label) => (
            <li class="flex items-center gap-3 px-4 py-3.5 text-body-sm text-ink">
              <svg viewBox="0 0 18 18" fill="none" aria-hidden="true" class="h-[18px] w-[18px] shrink-0 text-graphite">
                <circle cx="9" cy="9" r="7.25" stroke="currentColor" stroke-opacity=".35" stroke-width="1.5" />
                <path d="M5.3 9.3L7.7 11.6L12.7 6.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="flex-1">{label}</span>
              <span class="label text-stone">pass</span>
            </li>
          ))
        }
        <li class="flex items-center gap-3 bg-refuse-wash px-4 py-3.5 text-body-sm text-ink">
          <svg viewBox="0 0 18 18" fill="none" aria-hidden="true" class="h-[18px] w-[18px] shrink-0 text-refuse">
            <circle cx="9" cy="9" r="7.25" fill="currentColor" />
            <path d="M6.2 6.2L11.8 11.8M11.8 6.2L6.2 11.8" stroke="#fff" stroke-width="1.7" stroke-linecap="round" />
          </svg>
          <span class="flex-1 font-medium">What you actually asked for — only the signed intent knows</span>
          <span class="label text-refuse-ink">refuse</span>
        </li>
      </ul>
    </div>
  </div>
</section>
