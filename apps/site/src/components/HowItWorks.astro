---
// Pipeline order matters (a refusal from any stage wins), so the index is data.
const STAGES = [
  {
    name: "Idempotency",
    catches: "Already seen this exact payment — replays the cached result instead of paying twice.",
  },
  {
    name: "Policy",
    catches: "Budget, expiry, and network/asset — checked before anything else runs.",
  },
  {
    name: "Provenance",
    catches: "Whether the destination traces to what you signed, or only to untrusted page text.",
  },
  {
    name: "Intercepta",
    catches: "Screens the destination address and token for sanctions, scams, and drainers — live.",
  },
  {
    name: "Jev",
    catches: "Whether the payment matches what you actually asked for — semantically, not just by address.",
  },
  {
    name: "World ID → sign",
    catches: "Asks a live human when anything above is undecided, then signs — bound to that exact payment.",
  },
] as const;
---

<section id="how-it-works" class="band" aria-labelledby="how-heading">
  <div class="grid grid-cols-1 items-end gap-10 md:grid-cols-[1fr_auto]">
    <div>
      <h2 id="how-heading" class="headline text-[36px] leading-[1.06] tracking-[-0.02em] text-ink md:text-heading-lg">
        Six stages. <strong>All of them before any signature.</strong>
      </h2>
      <p class="mt-6 max-w-[52ch] text-body-lg text-graphite">
        Every stage runs, in order, before the firewall signs anything. A refusal from any stage wins outright.
      </p>
    </div>
    <img
      src="/art/firewall.webp"
      alt=""
      width="1024"
      height="1024"
      loading="lazy"
      decoding="async"
      class="pointer-events-none mx-auto w-[220px] select-none md:-mb-6 md:w-[280px]"
    />
  </div>

  <ol class="pipeline mt-14 grid grid-cols-1 lg:grid-cols-6" data-inview>
    {
      STAGES.map((stage, i) => (
        <li class="pipeline-node relative pb-8 pl-10 lg:pb-0 lg:pl-0 lg:pr-5" style={`--i: ${i}`}>
          <span class="pipeline-dot" data-final={i === STAGES.length - 1 ? "" : undefined} aria-hidden="true" />
          <p class="font-mono text-caption text-stone lg:pt-8">{String(i + 1).padStart(2, "0")}</p>
          <h3 class="mt-1.5 text-body-lg font-semibold text-ink">{stage.name}</h3>
          <p class="mt-2 text-body-sm text-graphite">{stage.catches}</p>
        </li>
      ))
    }
  </ol>

  <div class="mt-14 flex flex-col gap-2 rounded-card border border-hairline bg-fog px-5 py-4 md:flex-row md:items-center md:justify-between md:px-6">
    <p class="text-body text-ink">
      Fail-closed: any error or doubt ends in
      <span class="state-tag bg-refuse-wash text-refuse-ink">refuse</span>
      or
      <span class="state-tag bg-ask-wash text-ask-ink">ask a human</span>
      — never pay.
    </p>
    <p class="text-body-sm text-graphite">A refusal from any layer wins over a doubt.</p>
  </div>
</section>

<style>
  /* The connector rail: vertical on small screens, horizontal from lg. */
  .pipeline-node::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-hairline-strong);
  }
  .pipeline-node:last-child::before {
    bottom: auto;
    height: 10px;
  }
  .pipeline-dot {
    position: absolute;
    left: 0;
    top: 2px;
    width: 11px;
    height: 11px;
    border: 1px solid var(--color-ink);
    background: var(--color-ink);
  }
  .pipeline-dot[data-final] {
    border-color: var(--color-verified);
    background: var(--color-verified);
  }
  @media (min-width: 1024px) {
    .pipeline-node::before {
      left: 0;
      right: 0;
      top: 7px;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .pipeline-node:last-child::before {
      right: auto;
      width: 12px;
      height: 1px;
    }
    .pipeline-dot {
      top: 2px;
    }
  }

  /* Entrance: each stage lights up in order, the connector drawing on from
     one to the next. Without JS the diagram renders fully lit. */
  :global(.js) .pipeline-node::before {
    transform-origin: top;
    transition: transform 260ms linear;
    transition-delay: calc(var(--i) * 260ms + 120ms);
  }
  :global(.js) .pipeline-dot {
    transition:
      background-color 220ms var(--ease-out-soft),
      border-color 220ms var(--ease-out-soft),
      transform 320ms var(--ease-out-soft);
    transition-delay: calc(var(--i) * 260ms);
  }
  :global(.js) .pipeline:not(.is-in) .pipeline-node::before {
    transform: scaleY(0);
  }
  :global(.js) .pipeline:not(.is-in) .pipeline-dot {
    border-color: var(--color-hairline-strong);
    background: var(--color-surface);
    transform: scale(0.7);
  }
  @media (min-width: 1024px) {
    :global(.js) .pipeline-node::before {
      transform-origin: left;
    }
    :global(.js) .pipeline:not(.is-in) .pipeline-node::before {
      transform: scaleX(0);
    }
  }

  .state-tag {
    display: inline-block;
    border-radius: var(--radius-sm);
    padding: 1px 7px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-stretch: 90%;
    vertical-align: 1px;
  }
</style>
