---
import { SITE } from "../config";
import Arrow from "./Arrow.astro";
---

<section id="developers" class="band" aria-labelledby="dev-heading">
  <div class="grid grid-cols-1 items-end gap-10 md:grid-cols-[1fr_auto]">
    <div>
      <h2 id="dev-heading" class="headline text-[36px] leading-[1.06] tracking-[-0.02em] text-ink md:text-heading-lg">
        The same guard, <strong>in front of any agent.</strong>
      </h2>
      <p class="mt-6 max-w-[54ch] text-body-lg text-graphite">
        Omamori is an MCP server, so any MCP client can use it. Your agent never holds a key: it can only ask for a
        signature, and every request goes through the same checks.
      </p>
      <a href={SITE.githubUrl} class="btn btn-outline mt-8" rel="noopener" target="_blank">
        MCP tools and API on GitHub <Arrow dir="up-right" />
      </a>
    </div>
    <img
      src="/art/plug.webp"
      alt=""
      width="1024"
      height="1024"
      loading="lazy"
      decoding="async"
      class="pointer-events-none mx-auto w-[200px] select-none md:-mb-4 md:w-[250px]"
    />
  </div>
</section>
