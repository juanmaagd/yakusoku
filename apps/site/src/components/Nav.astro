---
import { SITE } from "../config";

const links = [
  { href: "#how-it-works", label: "How it works" },
  { href: "#proof", label: "Proof" },
  { href: "#developers", label: "Developers" },
  { href: SITE.githubUrl, label: "GitHub", external: true },
];
---

<header class="sticky top-0 z-50 h-16 border-b border-black/[0.08] bg-canvas shadow-nav">
  <div class="mx-auto grid h-16 max-w-[1440px] grid-cols-[auto_1fr_auto] items-center gap-4 px-6 md:px-10">
    <a href="/" class="text-body font-semibold tracking-[-0.242px] text-ink">
      {SITE.name}
    </a>

    <nav aria-label="Primary" class="hidden justify-center md:flex">
      <ul class="flex items-center gap-8">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noreferrer" : undefined}
                class="text-body-sm font-medium text-ink/54 transition-colors duration-200 ease-out hover:text-ink"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex justify-end">
      <a
        href={SITE.appRoute}
        class="rounded-btn bg-primary px-[15px] py-[6px] text-body-sm font-medium text-white transition-opacity duration-200 ease-out hover:opacity-90"
      >
        Launch app
      </a>
    </div>
  </div>
</header>
