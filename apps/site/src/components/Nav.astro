---
import { SITE } from "../config";

const links = [
  { href: "/#how-it-works", label: "How it works" },
  { href: "/#proof", label: "Proof" },
  { href: "/#developers", label: "Developers" },
  { href: SITE.githubUrl, label: "GitHub", external: true },
];
---

<header class="sticky top-0 z-50 border-b border-hairline bg-canvas">
  <div class="mx-auto grid h-16 max-w-[1200px] grid-cols-[auto_1fr_auto] items-center gap-4 px-6 md:px-8">
    <a href="/" class="flex items-center" aria-label={`${SITE.name} home`}>
      <img src="/brand/logo.svg" alt={SITE.name} width="116" height="24" class="h-6 w-auto" />
    </a>

    <nav aria-label="Primary" class="hidden justify-center md:flex">
      <ul class="flex items-center gap-8">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noreferrer" : undefined}
                class="text-body-sm text-graphite transition-colors duration-200 ease-out hover:text-ink"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex justify-end">
      <a href={SITE.appRoute} class="btn btn-primary">Launch app</a>
    </div>
  </div>
</header>
