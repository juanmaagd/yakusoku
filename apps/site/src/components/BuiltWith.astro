---
const STACK = ["x402", "Base Sepolia", "Intercepta", "World ID for Agents", "TypeSafe Jev"];
---

<section class="px-6 md:px-10">
  <div class="mx-auto max-w-[1200px] border-t border-black/[0.08] pt-10 pb-4">
    <p class="text-center text-caption font-medium text-ink/60">Built with</p>
    <ul class="mt-5 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
      {
        STACK.map((name) => (
          <li class="text-body font-medium text-ink/70">{name}</li>
        ))
      }
    </ul>
  </div>
</section>
