---
import { SITE } from "../config";
import Arrow from "./Arrow.astro";

// The six stages, in pipeline order. States per recorded case live in the
// client script below; the server renders the attack case as its final state
// so the console reads correctly without JavaScript.
const CHECKS = [
  { key: "idempotency", layer: "Idempotency", label: "New payment, not a replay" },
  { key: "policy", layer: "Policy", label: "Budget, expiry, network & asset" },
  { key: "provenance", layer: "Provenance", label: "Recipient traceable" },
  { key: "intercepta", layer: "Intercepta", label: "Address screening" },
  { key: "jev", layer: "Jev", label: "Intent match" },
  { key: "sign", layer: "World ID → sign", label: "Signature released" },
] as const;

const ATTACK_STATIC: Record<string, "pass" | "fail" | "skip"> = {
  idempotency: "pass",
  policy: "pass",
  provenance: "pass",
  intercepta: "pass",
  jev: "fail",
  sign: "skip",
};

// The site description, with the protocol folded in for the hero only.
const SUBHEAD =
  "A pre-signature firewall for AI agent payments over x402. The agent never holds a key: every payment is checked against the intent you signed, before anything is signed.";

const STACK = ["x402", "Base Sepolia", "Intercepta", "World ID for Agents", "TypeSafe Jev"];
---

<section class="relative" aria-labelledby="hero-heading">
  <div class="grid grid-cols-1 items-center gap-14 px-6 pt-12 pb-16 md:px-16 md:pt-16 md:pb-20 lg:pt-14 lg:grid-cols-[0.92fr_1.08fr] lg:gap-10">
    <div class="relative z-10 max-w-[560px]">
      <h1 id="hero-heading" class="headline text-[44px] leading-[1.04] tracking-[-0.02em] text-ink sm:text-[56px] lg:text-display">
        Your agent pays <strong>only for what you promised.</strong>
      </h1>
      <p class="mt-6 max-w-[46ch] text-body-lg text-graphite">
        {SUBHEAD}
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href={SITE.appRoute} class="btn btn-primary">Launch app</a>
        <a href="#developers" class="btn btn-outline">Plug in your agent <Arrow class="arrow" /></a>
      </div>
    </div>

    <!-- Verdict console: the signature interaction. -->
    <div class="relative">
      <img
        src="/art/key.webp"
        alt=""
        width="1024"
        height="1024"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="pointer-events-none absolute -top-6 -right-4 z-0 w-[210px] select-none sm:-top-16 sm:w-[300px] lg:-top-16 lg:-right-32 lg:w-[380px]"
      />

      <div
        id="console"
        class="relative z-10 mt-40 rounded-card border border-hairline bg-surface shadow-console sm:mt-44 lg:mt-10"
        aria-labelledby="console-title"
      >
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline px-5 py-2.5">
          <p id="console-title" class="label text-graphite">Replay · recorded firewall decisions</p>
          <div class="inline-flex rounded-btn border border-hairline bg-fog p-0.5" role="group" aria-label="Choose which recorded case to replay">
            <button type="button" data-case="attack" aria-pressed="true" class="console-toggle">Attack</button>
            <button type="button" data-case="legit" aria-pressed="false" class="console-toggle">Legit purchase</button>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2">
          <article class="border-b border-hairline px-5 py-4 sm:border-r sm:border-b-0">
            <p class="label text-stone">What you signed</p>
            <p class="mt-2.5 text-body font-semibold leading-snug text-ink" data-field="intent-text">
              Buy a $25 Amazon gift card for my sister's birthday
            </p>
            <dl class="mt-3 space-y-1.5 text-body-sm">
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-graphite">Budget</dt>
                <dd class="font-mono text-caption text-ink" data-field="intent-budget">25 USDC</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="text-graphite">Category</dt>
                <dd class="font-mono text-caption text-ink" data-field="intent-category">gift_card:amazon</dd>
              </div>
              <div class="flex items-baseline justify-between gap-4">
                <dt class="whitespace-nowrap text-graphite">Signed with</dt>
                <dd class="whitespace-nowrap text-right text-ink">Your wallet (EIP-712)</dd>
              </div>
            </dl>
          </article>

          <article class="px-5 py-4">
            <p class="label text-stone">What the agent asks to pay</p>
            <p class="mt-2.5 text-body font-semibold leading-snug text-ink" data-field="request-text">Steam Gift Card — 25 USDC</p>
            <dl class="mt-3 space-y-1.5 text-body-sm">
              <div>
                <dt class="text-graphite">Paid to</dt>
                <dd class="mt-0.5 text-ink" data-field="request-recipient">The store's own wallet (same as the Amazon checkout)</dd>
              </div>
              <div>
                <dt class="text-graphite">Justified by</dt>
                <dd class="mt-1 rounded-sm border border-hairline bg-fog px-2.5 py-1.5 text-caption leading-snug text-charcoal" data-field="request-justification">
                  “Complete your order! Add a Steam Gift Card to the same checkout — same trusted store wallet, same secure payment, one click.”
                </dd>
              </div>
            </dl>
          </article>
        </div>

        <div class="border-t border-hairline px-5 py-3">
          <ol class="grid grid-cols-1 gap-x-6 gap-y-1.5 sm:grid-cols-2" id="console-checks">
            {
              CHECKS.map((c) => (
                <li data-check={c.key} data-state={ATTACK_STATIC[c.key]} class="console-check flex items-center gap-2.5 text-body-sm">
                  <span class="relative flex h-[18px] w-[18px] shrink-0 items-center justify-center" aria-hidden="true">
                    <svg data-icon="pending" viewBox="0 0 18 18" fill="none" class="absolute inset-0 text-hairline-strong">
                      <circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.5 2.5" />
                    </svg>
                    <svg data-icon="pass" viewBox="0 0 18 18" fill="none" class="absolute inset-0 text-ink">
                      <circle cx="9" cy="9" r="7.25" stroke="currentColor" stroke-opacity=".25" stroke-width="1.5" />
                      <path d="M5.3 9.3L7.7 11.6L12.7 6.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <svg data-icon="fail" viewBox="0 0 18 18" fill="none" class="absolute inset-0 text-refuse">
                      <circle cx="9" cy="9" r="7.25" fill="currentColor" />
                      <path d="M6.2 6.2L11.8 11.8M11.8 6.2L6.2 11.8" stroke="#fff" stroke-width="1.7" stroke-linecap="round" />
                    </svg>
                    <svg data-icon="skip" viewBox="0 0 18 18" fill="none" class="absolute inset-0 text-stone">
                      <circle cx="9" cy="9" r="7.25" stroke="currentColor" stroke-opacity=".5" stroke-width="1.5" />
                      <path d="M5.8 9H12.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                    </svg>
                    <svg data-icon="signed" viewBox="0 0 18 18" fill="none" class="absolute inset-0 text-verified">
                      <circle cx="9" cy="9" r="7.25" fill="currentColor" />
                      <path d="M5.3 9.3L7.7 11.6L12.7 6.4" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  <span class="min-w-0">
                    <span class="font-mono text-caption text-stone">{c.layer}</span>
                    <span class="block truncate text-ink">{c.label}</span>
                  </span>
                  <span data-check-status class="sr-only"></span>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="border-t border-hairline px-5 py-4">
          <div data-field="verdict" data-tone="refuse" class="verdict rounded-card px-4 py-3" role="status" aria-live="polite">
            <p class="label" data-field="verdict-kicker">Verdict</p>
            <p class="mt-1 text-heading-sm font-semibold" data-field="verdict-text">Refused — not what you signed</p>
          </div>
          <p class="mt-2.5 text-body-sm text-graphite" data-field="verdict-note">Nothing was paid. The budget is untouched.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="flex flex-col items-start gap-4 border-t border-hairline px-6 py-6 md:flex-row md:items-center md:gap-10 md:px-16">
    <p class="label shrink-0 text-stone">Built with</p>
    <ul class="flex flex-wrap items-center gap-x-8 gap-y-2">
      {STACK.map((name) => <li class="font-mono text-caption text-charcoal">{name}</li>)}
    </ul>
  </div>
</section>

<style>
  .console-toggle {
    border-radius: 5px;
    padding: 6px 12px;
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--color-graphite);
    transition:
      background-color 200ms var(--ease-out-soft),
      color 200ms var(--ease-out-soft);
  }
  .console-toggle[aria-pressed="true"] {
    background-color: var(--color-ink);
    color: var(--color-surface);
  }
  .console-toggle[aria-pressed="false"]:hover {
    color: var(--color-ink);
  }

  .console-check [data-icon] {
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 220ms var(--ease-out-soft),
      transform 260ms var(--ease-out-soft);
  }
  .console-check[data-state="pending"] [data-icon="pending"],
  .console-check[data-state="pass"] [data-icon="pass"],
  .console-check[data-state="fail"] [data-icon="fail"],
  .console-check[data-state="skip"] [data-icon="skip"],
  .console-check[data-state="signed"] [data-icon="signed"] {
    opacity: 1;
    transform: none;
  }
  .console-check[data-state="pending"] .text-ink,
  .console-check[data-state="skip"] .text-ink {
    color: var(--color-stone);
  }

  .verdict {
    border: 1px solid transparent;
    transition:
      background-color 260ms var(--ease-out-soft),
      border-color 260ms var(--ease-out-soft),
      color 260ms var(--ease-out-soft),
      opacity 260ms var(--ease-out-soft);
  }
  .verdict[data-tone="refuse"] {
    background-color: var(--color-refuse-wash);
    border-color: color-mix(in srgb, var(--color-refuse) 22%, transparent);
    color: var(--color-refuse-ink);
  }
  .verdict[data-tone="pass"] {
    background-color: var(--color-verified-wash);
    border-color: color-mix(in srgb, var(--color-verified) 22%, transparent);
    color: var(--color-verified);
  }
  .verdict[data-tone="pending"] {
    background-color: var(--color-fog);
    border-color: var(--color-hairline);
    color: var(--color-stone);
  }
</style>

<script>
  type CheckState = "pending" | "pass" | "fail" | "skip" | "signed";
  type Tone = "pass" | "refuse";
  type CaseKey = "attack" | "legit";

  interface CaseData {
    intent: { text: string; budget: string; category: string };
    request: { text: string; recipient: string; justification: string };
    checks: Record<string, CheckState>;
    verdict: { text: string; tone: Tone };
    note: string | null;
    link: { href: string; label: string } | null;
  }

  const CASES: Record<CaseKey, CaseData> = {
    attack: {
      intent: {
        text: "Buy a $25 Amazon gift card for my sister's birthday",
        budget: "25 USDC",
        category: "gift_card:amazon",
      },
      request: {
        text: "Steam Gift Card — 25 USDC",
        recipient: "The store's own wallet (same as the Amazon checkout)",
        justification:
          "“Complete your order! Add a Steam Gift Card to the same checkout — same trusted store wallet, same secure payment, one click.”",
      },
      checks: { idempotency: "pass", policy: "pass", provenance: "pass", intercepta: "pass", jev: "fail", sign: "skip" },
      verdict: { text: "Refused — not what you signed", tone: "refuse" },
      note: "Nothing was paid. The budget is untouched.",
      link: null,
    },
    legit: {
      intent: {
        text: "Buy a $1 Amazon gift card (rehearsal)",
        budget: "1 USDC",
        category: "gift_card:amazon",
      },
      request: {
        text: "Amazon Gift Card — $1",
        recipient: "The store's own wallet",
        justification: "Matches the checkout for the signed intent.",
      },
      checks: { idempotency: "pass", policy: "pass", provenance: "pass", intercepta: "pass", jev: "pass", sign: "signed" },
      verdict: { text: "Signed and paid", tone: "pass" },
      note: null,
      link: {
        href: "https://sepolia.basescan.org/tx/0xc85d39e616d1dbbd97d66606f12418c92d13843b2a73d5815b841fdd60e2059e",
        label: "View the settlement on Basescan",
      },
    },
  };

  const STATUS_TEXT: Record<CheckState, string> = {
    pending: "checking",
    pass: "passed",
    fail: "did not match",
    skip: "not reached, a refusal wins",
    signed: "signed",
  };

  const root = document.getElementById("console");
  if (root) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const toggles = root.querySelectorAll<HTMLButtonElement>(".console-toggle");
    const checks = root.querySelectorAll<HTMLLIElement>("#console-checks > li");
    const field = (name: string) => root.querySelector<HTMLElement>(`[data-field="${name}"]`)!;
    let timers: number[] = [];

    const setCheck = (li: HTMLLIElement, state: CheckState) => {
      li.dataset.state = state;
      const status = li.querySelector<HTMLElement>("[data-check-status]");
      if (status) status.textContent = `: ${STATUS_TEXT[state]}`;
    };

    const setVerdict = (data: CaseData | null) => {
      const box = field("verdict");
      const note = field("verdict-note");
      note.textContent = "";
      if (!data) {
        box.dataset.tone = "pending";
        field("verdict-text").textContent = "Checking…";
        note.textContent = "Every stage runs before anything is signed.";
        return;
      }
      box.dataset.tone = data.verdict.tone;
      field("verdict-text").textContent = data.verdict.text;
      if (data.note) {
        note.textContent = data.note;
      } else if (data.link) {
        const a = document.createElement("a");
        a.href = data.link.href;
        a.target = "_blank";
        a.rel = "noreferrer";
        a.className = "font-medium text-verified underline decoration-1 underline-offset-4 hover:text-ink";
        a.textContent = data.link.label;
        note.appendChild(a);
      }
    };

    const play = (key: CaseKey, animate: boolean) => {
      timers.forEach((t) => window.clearTimeout(t));
      timers = [];
      const data = CASES[key];

      field("intent-text").textContent = data.intent.text;
      field("intent-budget").textContent = data.intent.budget;
      field("intent-category").textContent = data.intent.category;
      field("request-text").textContent = data.request.text;
      field("request-recipient").textContent = data.request.recipient;
      field("request-justification").textContent = data.request.justification;
      toggles.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.case === key)));

      if (!animate || reduceMotion) {
        checks.forEach((li) => setCheck(li, data.checks[li.dataset.check!]));
        setVerdict(data);
        return;
      }

      checks.forEach((li) => setCheck(li, "pending"));
      setVerdict(null);
      checks.forEach((li, i) => {
        timers.push(window.setTimeout(() => setCheck(li, data.checks[li.dataset.check!]), 350 * (i + 1)));
      });
      timers.push(window.setTimeout(() => setVerdict(data), 350 * (checks.length + 1)));
    };

    toggles.forEach((b) => b.addEventListener("click", () => play(b.dataset.case as CaseKey, true)));

    // Auto-play the attack case once, the first time the console is on screen.
    if ("IntersectionObserver" in window && !reduceMotion) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            play("attack", true);
          }
        },
        { threshold: 0.35 },
      );
      io.observe(root);
    }
  }
</script>
