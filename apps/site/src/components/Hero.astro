---
import { SITE } from "../config";
import Arrow from "./Arrow.astro";
import ErrandCard from "./ErrandCard.astro";

const SUBHEAD =
  "Approve once what your AI agent may buy — what, where, how much, until when. It shops on its own from an account you fund, and can't be talked into anything else.";

const STACK = ["x402", "Base Sepolia", "Intercepta", "World ID for Agents", "TypeSafe Jev"];
---

<section class="relative" aria-labelledby="hero-heading">
  <div class="grid grid-cols-1 items-center gap-12 px-6 pt-12 pb-16 md:px-16 md:pt-16 md:pb-20 lg:pt-8 lg:grid-cols-[0.92fr_1.08fr] lg:gap-10">
    <div class="relative z-10 max-w-[560px]">
      <h1 id="hero-heading" class="headline text-[44px] leading-[1.04] tracking-[-0.02em] text-ink sm:text-[56px] lg:text-display">
        Give your agent a budget, <strong>not your keys.</strong>
      </h1>
      <p class="mt-6 max-w-[46ch] text-body-lg text-graphite">
        {SUBHEAD}
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="#setup-agent" class="btn btn-primary">Set up your agent <Arrow class="arrow" /></a>
        <a href={SITE.appRoute} class="btn btn-outline">Launch app</a>
      </div>
    </div>

    <!-- The errand card: a real product fragment telling one purchase from request to receipt.
         From lg, the key art is a sculpture pinned to the top-right and the card floats over
         its lower-left — kept clear of the fixed tutorial dock (bottom-right). -->
    <div class="relative lg:min-h-[500px] lg:self-start">
      <img
        src="/art/key.webp"
        alt=""
        width="1024"
        height="1024"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="pointer-events-none mx-auto block w-[220px] select-none sm:w-[280px] lg:absolute lg:top-0 lg:right-0 lg:mx-0 lg:w-[480px]"
      />

      <div class="relative z-10 mx-auto -mt-16 w-full max-w-[460px] sm:-mt-20 lg:absolute lg:top-[10px] lg:left-0 lg:mx-0 lg:mt-0 lg:max-w-[420px]">
        <ErrandCard />
      </div>
    </div>
  </div>

  <div class="flex flex-col items-start gap-4 border-t border-hairline px-6 py-6 md:flex-row md:items-center md:gap-10 md:px-16">
    <p class="label shrink-0 text-stone">Built with</p>
    <ul class="flex flex-wrap items-center gap-x-8 gap-y-2">
      {STACK.map((name) => <li class="font-mono text-caption text-charcoal">{name}</li>)}
    </ul>
  </div>
</section>
