---
import { SITE } from "../config";
---

<section class="px-6 pb-20 md:px-10">
  <div class="mx-auto max-w-[1200px] rounded-card bg-sky-tint px-8 py-14 text-center md:py-16">
    <h2 class="text-heading-lg font-semibold text-ink">Give your agent a budget, not your keys.</h2>
    <div class="mt-8 flex justify-center">
      <a
        href={SITE.appRoute}
        class="rounded-btn bg-primary px-[15px] py-[6px] text-body-sm font-medium text-white transition-opacity duration-200 ease-out hover:opacity-90"
      >
        Launch app
      </a>
    </div>
  </div>
</section>
