---
import { EVIDENCE, basescanTx } from "../config";
import Arrow from "./Arrow.astro";

const hash = EVIDENCE.worldIdApprovedPayment;
const shortHash = `${hash.slice(0, 10)}…${hash.slice(-8)}`;
---

<section class="band" aria-labelledby="human-heading">
  <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <img
      src="/art/approval.webp"
      alt=""
      width="1024"
      height="1024"
      loading="lazy"
      decoding="async"
      class="pointer-events-none order-2 mx-auto w-[260px] select-none sm:w-[340px] lg:order-1 lg:w-[400px]"
    />

    <div class="order-1 lg:order-2">
      <h2 id="human-heading" class="headline text-[36px] leading-[1.06] tracking-[-0.02em] text-ink md:text-heading-lg">
        A human <strong>when it matters.</strong>
      </h2>
      <p class="mt-6 max-w-[54ch] text-body-lg text-graphite">
        When anything upstream is undecided, the firewall asks a live human to approve from their phone with World ID
        — a fresh identity check, not a stored credential. Once approved, the firewall signs a second attestation
        binding that exact approval to that exact payment, before it ever signs the payment itself.
      </p>
      <p class="mt-4 max-w-[54ch] text-body-lg text-graphite">
        A denied approval refuses the payment outright and restores the reserved budget.
      </p>

      <div class="mt-9 rounded-card border border-hairline bg-surface">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline px-5 py-3">
          <p class="label text-graphite">Real evidence · Base Sepolia</p>
          <p class="flex items-center gap-1.5 font-mono text-caption">
            <span class="rounded-sm bg-ask-wash px-1.5 py-px text-ask-ink">ask_human</span>
            <Arrow class="text-stone" />
            <span class="rounded-sm bg-verified-wash px-1.5 py-px text-verified">pay</span>
          </p>
        </div>
        <div class="px-5 py-4">
          <p class="text-body font-semibold text-ink">World ID approval → signed payment</p>
          <p class="mt-1.5 text-body-sm text-graphite">
            Bound by a StepUp attestation, re-verifiable independently of the firewall's own database.
          </p>
          <a
            href={basescanTx(hash)}
            target="_blank"
            rel="noreferrer"
            class="mt-3 inline-flex items-center gap-2 font-mono text-caption text-ink underline decoration-hairline-strong decoration-1 underline-offset-4 transition-colors duration-200 ease-out hover:decoration-ink"
          >
            {shortHash}
            <Arrow dir="up-right" />
            <span class="sr-only">View the transaction on Basescan</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
