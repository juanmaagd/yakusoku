---
import { EVIDENCE, basescanTx } from "../config";
---

<section class="px-6 md:px-10">
  <div class="mx-auto max-w-[1200px] overflow-hidden rounded-card bg-midnight px-8 py-12 text-white md:px-14 md:py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1fr_1fr] md:items-center">
      <div>
        <div class="mb-6 flex h-28 w-28 items-center justify-center rounded-full bg-white p-3">
          <img
            src="/illustrations/approval.webp"
            alt=""
            width="1024"
            height="683"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-contain"
          />
        </div>
        <h2 class="text-heading-lg font-semibold">A human when it matters</h2>
        <p class="mt-5 max-w-[52ch] text-body text-white/85">
          When anything upstream is undecided, the firewall asks a live human to approve from their phone with World
          ID — a fresh identity check, not a stored credential. Once approved, the firewall signs a second
          attestation binding that exact approval to that exact payment, before it ever signs the payment itself.
        </p>
        <p class="mt-4 max-w-[52ch] text-body text-white/85">
          A denied approval refuses the payment outright and restores the reserved budget.
        </p>
      </div>

      <div class="rounded-card border border-white/15 bg-white/5 p-6">
        <p class="text-body-sm font-medium text-white/60">Real evidence, Base Sepolia</p>
        <p class="mt-3 text-heading-sm font-semibold">World ID approval → signed payment</p>
        <p class="mt-2 text-body-sm text-white/80">Bound by a StepUp attestation, re-verifiable independently of the firewall's own database.</p>
        <a
          href={basescanTx(EVIDENCE.worldIdApprovedPayment)}
          target="_blank"
          rel="noreferrer"
          class="mt-4 inline-flex items-center gap-1.5 text-body-sm font-medium text-white underline decoration-white/40 decoration-1 underline-offset-4 transition-colors duration-200 ease-out hover:decoration-white"
        >
          View the transaction on Basescan
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
