---
// The hero's signature artifact: one purchase, told end to end — the
// request the human made, the agent's own attempt refused mid-story, and
// the purchase that actually matches. This owns the landing's one
// authored motion sequence (DESIGN.md's One-Shadow / one-sequence rule) —
// the Security section reuses the diff technique below in its final,
// unanimated state, never a second sequence.
---

<figure id="errand" class="errand rounded-card border border-hairline bg-surface shadow-console" aria-label="One purchase, from request to receipt">
  <dl class="e-row e-request border-b border-hairline px-5 pt-5 pb-4">
    <dt class="label text-stone">You asked</dt>
    <dd class="mt-1.5 text-body text-ink">A 25 USDC Amazon gift card for my sister's birthday.</dd>
  </dl>

  <ol class="divide-y divide-hairline">
    <li class="e-row e-step px-5 py-4" style="--i: 0">
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
        <span class="state-tag bg-verified-wash text-verified">approved</span>
        <p class="text-body text-ink">Intent · Amazon gift card · 25 USDC · 24 h</p>
      </div>
      <p class="mt-1.5 text-body-sm text-graphite">One tap in World App</p>
    </li>

    <li class="e-row e-step e-step-refuse px-5 py-4" style="--i: 1">
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
        <span class="state-tag bg-refuse-wash text-refuse-ink">refused</span>
        <p class="text-body text-ink"><mark class="p-diff">Steam</mark> gift card · 25 USDC</p>
      </div>
      <p class="mt-1.5 text-body-sm text-graphite">Suggested by the store's promo copy — not what you asked. Nothing paid.</p>
    </li>

    <li class="e-row e-step px-5 py-4" style="--i: 2">
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
        <span class="state-tag bg-verified-wash text-verified">paid</span>
        <p class="text-body text-ink">Amazon gift card · 25 USDC</p>
      </div>
      <p class="mt-1.5 text-body-sm text-graphite">Receipt sent · code delivered to you</p>
    </li>
  </ol>

  <div class="e-row e-footer flex items-center justify-between border-t border-hairline px-5 py-4">
    <span class="label text-stone">Budget left</span>
    <span class="font-mono text-body text-ink tabular-nums">0 USDC</span>
  </div>
</figure>

<button type="button" id="errand-replay" class="replay label mt-3 inline-flex items-center gap-1.5 rounded-sm px-1.5 py-1 text-graphite">
  <svg viewBox="0 0 16 16" fill="none" class="h-3 w-3" aria-hidden="true">
    <path d="M3 8a5 5 0 1 0 1.6-3.7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    <path d="M3.2 2.2v2.6h2.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  Replay
</button>

<style>
  /* The mismatched word: a refuse wash with an underline, swept in — same
     technique as the Security section's static artifact, animated here. */
  .p-diff {
    border-radius: 2px;
    padding: 0 2px;
    margin: 0 -2px;
    color: inherit;
    background-image:
      linear-gradient(var(--color-refuse), var(--color-refuse)),
      linear-gradient(var(--color-refuse-wash), var(--color-refuse-wash));
    background-repeat: no-repeat;
    background-position:
      left bottom,
      left center;
    background-size:
      100% 1.5px,
      100% 100%;
  }

  .replay {
    transition: color 200ms var(--ease-out-soft);
  }
  .replay:hover {
    color: var(--color-ink);
  }
  :global(html:not(.js)) .replay {
    display: none;
  }

  /* Sequence (the landing's only authored motion). Hidden start states
     apply only with JS; the final state is the default. */
  :global(.js) .errand .e-row {
    transition:
      opacity 380ms var(--ease-out-soft),
      transform 380ms var(--ease-out-soft);
  }
  :global(.js) .errand .e-request {
    transition-delay: 0ms;
  }
  :global(.js) .errand .e-step {
    transition-delay: calc(300ms + var(--i) * 380ms);
  }
  :global(.js) .errand .e-step-refuse .p-diff {
    transition: background-size 420ms var(--ease-out-soft) calc(300ms + var(--i) * 380ms + 260ms);
  }
  :global(.js) .errand .e-footer {
    transition-delay: 1450ms;
  }

  :global(.js) .errand:not(.is-played) .e-row {
    opacity: 0;
    transform: translateY(6px);
  }
  :global(.js) .errand:not(.is-played) .e-step-refuse .p-diff {
    background-size:
      0% 1.5px,
      0% 100%;
  }

  .errand.no-anim,
  .errand.no-anim * {
    transition: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .errand,
    .errand * {
      transition: none !important;
    }
  }
</style>

<script>
  const card = document.getElementById("errand");
  const replay = document.getElementById("errand-replay");

  if (card) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Restart from the hidden state without animating the way back.
    const play = () => {
      card.classList.add("no-anim");
      card.classList.remove("is-played");
      void card.offsetWidth;
      card.classList.remove("no-anim");
      card.classList.add("is-played");
    };

    replay?.addEventListener("click", play);

    if (reduceMotion || !("IntersectionObserver" in window)) {
      card.classList.add("is-played");
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            card.classList.add("is-played");
          }
        },
        { threshold: 0.4 },
      );
      io.observe(card);
    }
  }
</script>
