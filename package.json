{
  "name": "yakusoku",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter \"@yakusoku/*\" typecheck",
    "test": "bun test --pass-with-no-tests --path-ignore-patterns=\"contracts/**\"",
    "store": "bun run --filter @yakusoku/store dev",
    "firewall": "bun run --filter @yakusoku/firewall dev",
    "site": "bun run --filter @yakusoku/site dev",
    "roundtrip": "bun run --filter @yakusoku/firewall roundtrip",
    "jev-cases": "bun run --filter @yakusoku/firewall jev-cases",
    "intercepta-check": "bun run --filter @yakusoku/firewall intercepta-check",
    "world-id-check": "bun run --filter @yakusoku/firewall world-id-check",
    "scenarios": "bun run --filter @yakusoku/firewall scenarios",
    "reset-data": "bun run --filter @yakusoku/firewall reset-data",
    "account-payment-check": "bun run --filter @yakusoku/firewall account-payment-check",
    "agent": "bun run --filter @yakusoku/agent start",
    "dev-intent": "bun run --filter @yakusoku/agent dev-intent",
    "attack": "bun run --filter @yakusoku/agent attack",
    "mcp": "bun run --filter @yakusoku/mcp start",
    "verify": "bun run --filter @yakusoku/verifier verify"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
