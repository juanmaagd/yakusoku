{
  "name": "yakusoku",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter \"@yakusoku/*\" typecheck",
    "test": "bun test --pass-with-no-tests",
    "store": "bun run --filter @yakusoku/store dev",
    "firewall": "bun run --filter @yakusoku/firewall dev",
    "web": "bun run --filter @yakusoku/web dev",
    "roundtrip": "bun run --filter @yakusoku/firewall roundtrip",
    "jev-cases": "bun run --filter @yakusoku/firewall jev-cases",
    "agent": "bun run --filter @yakusoku/agent start",
    "dev-intent": "bun run --filter @yakusoku/agent dev-intent"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
