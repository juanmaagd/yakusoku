# One image for every bun-based Omamorisan service (firewall, store, mcp) —
# T3, odd/tasks/dokploy-deploy.md. This is a bun workspaces monorepo, so the
# build context is the repo root and `bun install` resolves every workspace
# member in one shot; docker-compose.yml gives each service its own
# `command:` to pick which app actually runs. Single stage on purpose (Bun
# runs TypeScript directly — no separate compile step) and no
# COPY-package.json-first layer-caching trick, to keep this file simple:
# `bun install` reruns on every source change either way, which is an
# acceptable tradeoff for a hackathon deploy.
FROM oven/bun:1

WORKDIR /app

COPY . .
RUN bun install --frozen-lockfile

# Security review (odd/tasks/dokploy-deploy.md) — run as the image's
# built-in non-root `bun` user (uid/gid 1000), not root. `bun install` still
# runs as root above (running it as `bun` hits a "failed to link package"
# ENOENT for several platform-optional native deps — a bun/non-root
# interaction, not something this app controls), so `/app` needs an explicit
# chown afterward. `/data` (the firewall's SQLite dir, FIREWALL_DATA_DIR=/data
# in docker-compose.yml) is created and chowned here too, as root, before the
# `USER bun` switch below: `/` itself isn't writable by a non-root user, and
# a named volume mounted at a path with no prior content in the image
# inherits that path's ownership from the image on its first mount — an
# unprepared /data would come up root-owned, and the firewall's own
# `mkdirSync`/sqlite open would fail to write as `bun`.
RUN mkdir -p /data && chown -R bun:bun /app /data

USER bun

# firewall (:4001), store (:4000), mcp HTTP (:4010) — see docker-compose.yml
# for which port(s) each service actually publishes.
EXPOSE 4000 4001 4010

# Overridden per service in docker-compose.yml; this default keeps a bare
# `docker build && docker run` on this image doing something sane.
CMD ["bun", "run", "apps/firewall/index.ts"]
